{
  "name": "wizelens-monorepo",
  "private": true,
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "build": "pnpm -r --filter \"./js/packages/*\" build",
    "test": "pnpm -r --filter \"./js/packages/*\" test",
    "check:size": "node scripts/check-size.mjs",
    "dev:web": "pnpm --filter sample-web dev",
    "dev:orders": "pnpm --filter sample-orders-api dev",
    "dev:hub": "pnpm --filter @wizeworks/lens-hub start"
  }
}

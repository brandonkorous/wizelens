        { "spanId": "c1", "parentSpanId": "s1", "category": "http.client", "attributes": { "http.request.method": "POST", "url.full": "https://hooks.example.net/in" } }
      ],
      "findings": [{ "kind": "ssrf", "severity": "error", "shape": "POST hooks.example.net/in", "count": 1, "spanIds": ["c1"] }]
    },

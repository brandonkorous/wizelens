        { "spanId": "d1", "parentSpanId": "s1", "category": "db", "attributes": { "db.system.name": "postgresql", "db.query.text": "INSERT INTO cards VALUES ($1)", "wizelens.db.parameters": "[\"[redacted:card]\"]" } }

    {
      "name": "SSRF: the query names the URL the server calls",
      "spans": [
        { "spanId": "s1", "category": "http.server", "attributes": { "http.request.method": "GET", "url.path": "/preview", "url.query": "url=https%3A%2F%2Fevil.example.com%2Fa", "http.route": "/preview", "http.response.status_code": 200 } },
        { "spanId": "c1", "parentSpanId": "s1", "category": "http.client", "attributes": { "http.request.method": "GET", "url.full": "https://evil.example.com/a" } },
        { "spanId": "c2", "parentSpanId": "s1", "category": "http.client", "attributes": { "http.request.method": "GET", "url.full": "https://api.example.com/log" } }
      ],
      "findings": [{ "kind": "ssrf", "severity": "error", "shape": "GET evil.example.com/a", "count": 1, "spanIds": ["c1"] }]
    },
    {
      "name": "SSRF: the body names the host",
      "spans": [

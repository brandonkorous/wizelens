{
  "about": "Security rule vectors (docs/CONTRACT.md, Security analysis). The TS and .NET suites run them. A span lists only what it sets: spanId, category, and attributes; tests fill the rest (no parent, 10 ms, service api). Data is as stored, after redaction. Findings compare sorted by kind, then shape.",
  "cases": [
    {
      "name": "query input in a LIKE literal",
      "spans": [
        { "spanId": "s1", "category": "http.server", "attributes": { "http.request.method": "GET", "url.path": "/search", "url.query": "q=shoes&page=1", "http.route": "/search", "http.response.status_code": 200 } },
        { "spanId": "d1", "parentSpanId": "s1", "category": "db", "attributes": { "db.system.name": "postgresql", "db.query.text": "SELECT * FROM products WHERE name LIKE '%shoes%' LIMIT 20" } },
        { "spanId": "d2", "parentSpanId": "s1", "category": "db", "attributes": { "db.system.name": "postgresql", "db.query.text": "SELECT * FROM products WHERE name LIKE $1", "wizelens.db.parameters": "[\"%shoes%\"]" } }
      ],
      "findings": [{ "kind": "sql-injection", "severity": "error", "shape": "SELECT * FROM products WHERE name LIKE '%shoes%' LIMIT 20", "count": 1, "spanIds": ["d1"] }]
    },
    {
      "name": "path value as a compared number, twice",
      "spans": [
        { "spanId": "s1", "category": "http.server", "attributes": { "http.request.method": "GET", "url.path": "/orders/42", "http.route": "/orders/{id}", "http.response.status_code": 200 } },
        { "spanId": "d1", "parentSpanId": "s1", "category": "db", "attributes": { "db.system.name": "mysql", "db.query.text": "SELECT * FROM orders WHERE id = 42" } },
        { "spanId": "d2", "parentSpanId": "s1", "category": "db", "attributes": { "db.system.name": "mysql", "db.query.text": "SELECT * FROM orders WHERE id = 42" } },
        { "spanId": "d3", "parentSpanId": "s1", "category": "db", "attributes": { "db.system.name": "mysql", "db.query.text": "SELECT * FROM items WHERE qty > 420" } }
      ],
      "findings": [{ "kind": "sql-injection", "severity": "error", "shape": "SELECT * FROM orders WHERE id = 42", "count": 2, "spanIds": ["d1", "d2"] }]
    },
    {
      "name": "JSON body value in a quoted literal; short and NoSQL values do not count",
      "spans": [
        { "spanId": "s1", "category": "http.server", "attributes": { "http.request.method": "POST", "url.path": "/login", "url.query": "x=a", "http.route": "/login", "http.response.status_code": 200, "wizelens.request.body": "{\"email\":\"bob@example.com\",\"remember\":true}" } },
        { "spanId": "d1", "parentSpanId": "s1", "category": "db", "attributes": { "db.system.name": "microsoft.sql_server", "db.query.text": "SELECT id FROM users WHERE email = 'bob@example.com' AND flag = 'a'" } },
        { "spanId": "d2", "parentSpanId": "s1", "category": "db", "attributes": { "db.system.name": "redis", "db.query.text": "GET 'bob@example.com'" } }
      ],
      "findings": [{ "kind": "sql-injection", "severity": "error", "shape": "SELECT id FROM users WHERE email = 'bob@example.com' AND flag = 'a'", "count": 1, "spanIds": ["d1"] }]
    },
    {
      "name": "HTML over HTTPS: missing headers, version headers, and cookie flags",
      "spans": [
        {
          "spanId": "s1",
          "category": "http.server",
          "attributes": {
            "http.request.method": "GET", "url.path": "/", "http.route": "/", "http.response.status_code": 200,
            "http.request.header.x-forwarded-proto": "https",
            "http.response.header.content-type": "text/html; charset=utf-8",
            "http.response.header.server": "nginx/1.25.3",
            "http.response.header.x-powered-by": "Express",
            "http.response.header.set-cookie": "sid=[redacted]; Path=/, theme=[redacted]; Path=/; HttpOnly, gone=[redacted]; Max-Age=0"
          }
        }
      ],
      "findings": [
        { "kind": "cookie-flags", "severity": "warning", "shape": "cookie sid: missing HttpOnly, Secure", "count": 1, "spanIds": ["s1"] },
        { "kind": "cookie-flags", "severity": "warning", "shape": "cookie theme: missing Secure", "count": 1, "spanIds": ["s1"] },
        { "kind": "missing-headers", "severity": "warning", "shape": "content-security-policy", "count": 1, "spanIds": ["s1"] },
        { "kind": "missing-headers", "severity": "info", "shape": "strict-transport-security, x-content-type-options, x-frame-options (behind a proxy: check the answer it sends)", "count": 1, "spanIds": ["s1"] },
        { "kind": "version-header", "severity": "info", "shape": "server: nginx/1.25.3", "count": 1, "spanIds": ["s1"] },
        { "kind": "version-header", "severity": "info", "shape": "x-powered-by: Express", "count": 1, "spanIds": ["s1"] }
      ]
    },
    {
      "name": "no proxy: missing edge headers stay warnings; a report-only CSP is info, not missing",
      "spans": [
        {
          "spanId": "s1",
          "category": "http.server",
          "attributes": {
            "http.request.method": "GET", "url.path": "/", "http.route": "/", "http.response.status_code": 200, "url.scheme": "https",
            "http.response.header.content-type": "text/html",
            "http.response.header.x-frame-options": "DENY",
            "http.response.header.content-security-policy-report-only": "default-src 'self'"
          }
        }
      ],
      "findings": [
        { "kind": "missing-headers", "severity": "warning", "shape": "strict-transport-security, x-content-type-options", "count": 1, "spanIds": ["s1"] },
        { "kind": "missing-headers", "severity": "info", "shape": "content-security-policy-report-only: reports, does not block", "count": 1, "spanIds": ["s1"] }
      ]
    },
    {
      "name": "well set headers give nothing; SameSite=None needs Secure even over HTTP",
      "spans": [
        {
          "spanId": "s1",
          "category": "http.server",
          "attributes": {
            "http.request.method": "GET", "url.path": "/app", "http.route": "/app", "http.response.status_code": 200,
            "http.response.header.content-type": "text/html",
            "http.response.header.x-content-type-options": "nosniff",
            "http.response.header.content-security-policy": "default-src 'self'; frame-ancestors 'none'",
            "http.response.header.server": "Kestrel",
            "http.response.header.set-cookie": "pref=[redacted]; SameSite=None"
          }
        }
      ],
      "findings": [{ "kind": "cookie-flags", "severity": "warning", "shape": "cookie pref: missing Secure", "count": 1, "spanIds": ["s1"] }]
    },
    {
      "name": "headers not captured: no header rules; a cookie redacted whole is unknown",
      "spans": [
        { "spanId": "s1", "category": "http.server", "attributes": { "http.request.method": "GET", "url.path": "/x", "http.response.status_code": 200, "url.scheme": "https" } }
      ],
      "findings": []
    },
    {
      "name": "CORS: any origin with credentials",
      "spans": [
        { "spanId": "s1", "category": "http.server", "attributes": { "http.request.method": "GET", "url.path": "/api", "http.route": "/api", "http.response.status_code": 200, "http.response.header.x-content-type-options": "nosniff", "http.response.header.access-control-allow-origin": "*", "http.response.header.access-control-allow-credentials": "true" } }
      ],
      "findings": [{ "kind": "cors", "severity": "warning", "shape": "access-control-allow-origin: *, with credentials", "count": 1, "spanIds": ["s1"] }]
    },
    {
      "name": "CORS: the null origin",
      "spans": [
        { "spanId": "s1", "category": "http.server", "attributes": { "http.request.method": "GET", "url.path": "/api", "http.response.status_code": 204, "http.response.header.x-content-type-options": "nosniff", "http.response.header.access-control-allow-origin": "null" } }
      ],
      "findings": [{ "kind": "cors", "severity": "warning", "shape": "access-control-allow-origin: null", "count": 1, "spanIds": ["s1"] }]
    },
    {
      "name": "secrets in the request URL and in a call URL",
      "spans": [
        { "spanId": "s1", "category": "http.server", "attributes": { "http.request.method": "GET", "url.path": "/reset", "url.query": "token=[redacted]&id=5", "http.route": "/reset", "http.response.status_code": 302 } },
        { "spanId": "c1", "parentSpanId": "s1", "category": "http.client", "attributes": { "http.request.method": "GET", "url.full": "https://api.example.com/v1/rates?api_key=[redacted]&base=usd" } }
      ],
      "findings": [
        { "kind": "secret-in-url", "severity": "warning", "shape": "GET /reset?token={}", "count": 1, "spanIds": ["s1"] },
        { "kind": "secret-in-url", "severity": "warning", "shape": "GET api.example.com/v1/rates?api_key={}&base={}", "count": 1, "spanIds": ["c1"] }
      ]
    },
    {
      "name": "plain HTTP to a public host only",
      "spans": [
        { "spanId": "c1", "category": "http.client", "attributes": { "http.request.method": "POST", "url.full": "http://api.partner.com/charge" } },
        { "spanId": "c2", "category": "http.client", "attributes": { "http.request.method": "GET", "url.full": "http://orders.default.svc.cluster.local/x" } },
        { "spanId": "c3", "category": "http.client", "attributes": { "http.request.method": "GET", "url.full": "http://10.0.0.5:8080/x" } },
        { "spanId": "c4", "category": "http.client", "attributes": { "http.request.method": "GET", "url.full": "http://orders:8080/x" } },
        { "spanId": "c5", "category": "http.client", "attributes": { "http.request.method": "GET", "url.scheme": "http", "server.address": "cdn.example.org", "url.path": "/a" } },
        { "spanId": "c6", "category": "http.client", "attributes": { "http.request.method": "GET", "url.full": "http://[::1]:5000/x" } }
      ],
      "findings": [
        { "kind": "plain-http", "severity": "warning", "shape": "GET cdn.example.org/a", "count": 1, "spanIds": ["c5"] },

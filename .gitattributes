# Store and check out text files with LF on every OS (matches .editorconfig).
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never touch line endings or diff as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
*.db   binary
*.dll  binary
*.exe  binary
*.nupkg binary

# Generated lock file: do not show noisy diffs.
pnpm-lock.yaml -diff linguist-generated=true

{
  "name": "@wizeworks/lens-hub",
  "version": "0.3.0-alpha.12",
  "description": "The WizeLens local hub: one place for the traces of every service on your machine or network, with the full dashboard and MCP.",
  "license": "MIT",
  "author": "WizeWorks LLC",
  "homepage": "https://github.com/brandonkorous/wizelens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandonkorous/wizelens.git",
    "directory": "js/packages/hub"
  },
  "bugs": {
    "url": "https://github.com/brandonkorous/wizelens/issues"
  },
  "keywords": [
    "wizelens",
    "hub",
    "tracing",
    "opentelemetry",
    "otlp",
    "profiler",
    "dashboard"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wizelens-hub": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./kit": {
      "types": "./dist/kit.d.ts",
      "import": "./dist/kit.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@wizeworks/lens-core": "workspace:^",
    "@wizeworks/lens-node": "workspace:^",
    "@wizeworks/lens-ui": "workspace:^",
    "protobufjs": "^7.6.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}

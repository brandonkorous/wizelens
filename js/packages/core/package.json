{
  "name": "@wizeworks/lens-core",
  "version": "0.3.0-alpha.14",
  "description": "Shared types, trace context helpers, and analysis for WizeLens.",
  "license": "MIT",
  "author": "WizeWorks LLC",
  "homepage": "https://github.com/brandonkorous/wizelens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandonkorous/wizelens.git",
    "directory": "js/packages/core"
  },
  "bugs": {
    "url": "https://github.com/brandonkorous/wizelens/issues"
  },
  "keywords": [
    "wizelens",
    "tracing",
    "opentelemetry",
    "diagnostics",
    "profiler"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.json --noEmit && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@wizeworks/lens-cloud",
  "version": "0.3.0-alpha.7",
  "description": "The WizeLens cloud service: many organizations, accounts and teams, server-side stats, alerts, sharing, and scoped AI access, on Postgres.",
  "license": "MIT",
  "author": "WizeWorks LLC",
  "homepage": "https://github.com/brandonkorous/wizelens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandonkorous/wizelens.git",
    "directory": "js/packages/cloud"
  },
  "bugs": {
    "url": "https://github.com/brandonkorous/wizelens/issues"
  },
  "keywords": [
    "wizelens",
    "cloud",
    "tracing",
    "opentelemetry",
    "otlp",
    "profiler",
    "postgres"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wizelens-cloud": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "email:preview": "node dist/mail/preview.js"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.10",
    "@better-auth/passkey": "1.7.10",
    "@better-auth/scim": "1.7.10",
    "@better-auth/sso": "1.7.10",
    "@better-auth/stripe": "1.7.10",
    "@electric-sql/pglite": "^0.5.10",
    "@react-email/components": "1.0.12",
    "@wizeworks/lens-core": "workspace:^",
    "@wizeworks/lens-hub": "workspace:^",
    "@wizeworks/lens-node": "workspace:^",
    "@wizeworks/lens-ui": "workspace:^",
    "better-auth": "1.7.10",
    "kysely": "^0.29.6",
    "kysely-pglite-dialect": "^1.4.0",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "22.6.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}

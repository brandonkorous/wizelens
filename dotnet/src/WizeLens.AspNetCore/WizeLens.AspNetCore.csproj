<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>WizeLens</RootNamespace>
        <Description>Glimpse-style request profiling for ASP.NET Core. Captures HTTP, database, logs and exceptions per request, serves a dashboard at /_wizelens, and exposes insights to AI agents over MCP.</Description>
        <UiDistDir>$(RepoRoot)\js\packages\ui\dist\</UiDistDir>
        <HudDistDir>$(RepoRoot)\js\packages\browser\dist\</HudDistDir>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="$(MsLibVersion)" />
        <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
        <!-- The MCP SDK brings Logging.Abstractions 10 to .NET 8; Logging 10 keeps ProviderAlias in one place. -->
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" Condition="'$(TargetFramework)' == 'net8.0'" />
    </ItemGroup>

    <!-- The dashboard UI is built by js/packages/ui (Vite). Embed it when it exists. -->
    <ItemGroup>
        <EmbeddedResource Include="$(UiDistDir)**\*" Condition="Exists('$(UiDistDir)index.html')">
            <LogicalName>ui/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
            <Link>ui\%(RecursiveDir)%(Filename)%(Extension)</Link>
        </EmbeddedResource>
    </ItemGroup>

    <!-- The HUD is the lens-browser script-tag bundle (Vite). Embed it when it exists; served at {BasePath}/wizelens.js. -->
    <ItemGroup Condition="Exists('$(HudDistDir)wizelens.iife.js')">
        <EmbeddedResource Include="$(HudDistDir)wizelens.iife.js" LogicalName="hud/wizelens.js" Link="hud\wizelens.js" />
        <EmbeddedResource Include="$(HudDistDir)wizelens.iife.js.map" LogicalName="hud/wizelens.js.map" Link="hud\wizelens.js.map" Condition="Exists('$(HudDistDir)wizelens.iife.js.map')" />
    </ItemGroup>

    <!-- A CI build packs what it builds, so the dashboard and the HUD must be there; run pnpm build first. -->
    <Target Name="RequireWebFiles" BeforeTargets="BeforeBuild" Condition="'$(CI)' == 'true'">
        <Error Condition="!Exists('$(UiDistDir)index.html')" Text="The dashboard is not built ($(UiDistDir)index.html). Run pnpm build before the .NET build." />
        <Error Condition="!Exists('$(HudDistDir)wizelens.iife.js')" Text="The HUD script is not built ($(HudDistDir)wizelens.iife.js). Run pnpm build before the .NET build." />
    </Target>

    <ItemGroup>
        <InternalsVisibleTo Include="WizeLens.Tests" />
        <InternalsVisibleTo Include="WizeLens.EntityFrameworkCore" />
        <InternalsVisibleTo Include="WizeLens.Serilog" />
        <InternalsVisibleTo Include="WizeLens.NLog" />
        <InternalsVisibleTo Include="WizeLens.AutoInstrumentation" />
        <InternalsVisibleTo Include="WizeLens.Redis" />
        <InternalsVisibleTo Include="WizeLens.MongoDB" />
        <InternalsVisibleTo Include="WizeLens.Elasticsearch" />
    </ItemGroup>

</Project>

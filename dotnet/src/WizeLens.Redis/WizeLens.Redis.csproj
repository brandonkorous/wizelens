<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Redis (StackExchange.Redis) adapter for WizeLens. Records every command as a db span in the trace of the request that sent it, with the key shape (ids become ?) and never the values.</Description>
        <PackageTags>$(PackageTags);redis;stackexchange.redis;cache</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="StackExchange.Redis" Version="2.9.32" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\WizeLens.AspNetCore\WizeLens.AspNetCore.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="WizeLens.Tests" />
    </ItemGroup>

</Project>

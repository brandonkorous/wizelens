<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>MongoDB (MongoDB.Driver) adapter for WizeLens. Records every command as a db span in the trace of the request that sent it, with the command's shape (values become ?) and never the values.</Description>
        <PackageTags>$(PackageTags);mongodb;mongo</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MongoDB.Driver" Version="3.12.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\WizeLens.AspNetCore\WizeLens.AspNetCore.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="WizeLens.Tests" />
    </ItemGroup>

</Project>

<Project>
    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</RepoRoot>

        <Authors>WizeWorks LLC</Authors>
        <Company>WizeWorks LLC</Company>
        <Copyright>Copyright (c) 2026 WizeWorks LLC</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/brandonkorous/wizelens</PackageProjectUrl>
        <RepositoryUrl>https://github.com/brandonkorous/wizelens.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
        <PackageReleaseNotes>https://github.com/brandonkorous/wizelens/blob/main/CHANGELOG.md</PackageReleaseNotes>
        <PackageTags>wizelens;glimpse;opentelemetry;tracing;diagnostics;aspnetcore;mcp</PackageTags>
        <Version>0.3.0-alpha.14</Version>
    </PropertyGroup>
    <!-- .NET 8 builds take the 8.0 line of the Microsoft packages; .NET 9 apps use the .NET 8 build. -->
    <PropertyGroup>
        <MsLibVersion Condition="'$(TargetFramework)' == 'net8.0'">8.0.33</MsLibVersion>
        <MsLibVersion Condition="'$(MsLibVersion)' == ''">10.0.13</MsLibVersion>
    </PropertyGroup>
    <!-- On .NET 8, Activity.AddException needs the newer DiagnosticSource (it supports .NET 8). -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.13" />
    </ItemGroup>
    <ItemGroup Condition="'$(IsPackable)' != 'false'">
        <None Include="$(MSBuildThisFileDirectory)PACKAGE.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>
</Project>

<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</RepoRoot>

        <Authors>WizeWorks LLC</Authors>
        <Company>WizeWorks LLC</Company>
        <Copyright>Copyright (c) 2026 WizeWorks LLC</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/brandonkorous/wizelens</PackageProjectUrl>
        <RepositoryUrl>https://github.com/brandonkorous/wizelens.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
        <PackageReleaseNotes>https://github.com/brandonkorous/wizelens/blob/main/CHANGELOG.md</PackageReleaseNotes>
        <PackageTags>wizelens;glimpse;opentelemetry;tracing;diagnostics;aspnetcore;mcp</PackageTags>
        <Version>0.3.0-alpha.4</Version>
    </PropertyGroup>
    <ItemGroup Condition="'$(IsPackable)' != 'false'">
        <None Include="$(MSBuildThisFileDirectory)PACKAGE.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>
</Project>
